# OSS 资源服务配置示例
# 复制此文件为 application-local.yml 或通过环境变量配置

# 腾讯云 COS 配置示例：
# export COS_SECRET_ID=你的SecretId
# export COS_SECRET_KEY=你的SecretKey
# export COS_REGION=ap-guangzhou
# export COS_BUCKET_NAME=your-bucket-name
# export COS_BASE_URL=https://your-bucket.cos.region.myqcloud.com
# export COS_PATH_PREFIX=im

# 或者创建 application-local.yml（已在 .gitignore 中）：
link:
  oss:
    cos:
      secret-id: 你的腾讯云SecretId
      secret-key: 你的腾讯云SecretKey
      region: ap-guangzhou
      bucket-name: your-bucket-name
      base-url: https://your-bucket.cos.region.myqcloud.com
      path-prefix: im
