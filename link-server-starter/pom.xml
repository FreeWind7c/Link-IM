<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.link</groupId>
        <artifactId>cc-link</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>link-server-starter</artifactId>
    <name>link-server-starter</name>
    <description>运行入口/组装根：持有 main 与全局配置，把 core + api 拼成可启动的 Spring Boot 应用，绑定 Netty 与 HTTP 端口。</description>

    <!--
      装：LinkImApplication（启动类）、config/{MongoConfig,RedisConfig}、application.yml、lua/* 等运行资源。
      唯一产出可执行 jar 的模块；core / api / im / common 经传递依赖被打进来。
      微服务阶段：本模块演变为对外边缘网关，core 与 api 各自独立成服务。
    -->
    <!--
      Netty 接入进程：只依赖 link-im（传递带上 link-core 引擎 + link-common）。
      不依赖 link-restapi，故 classpath 无 webmvc，不启动 HTTP。唯一产出可执行 jar 的接入端。
    -->
    <dependencies>
        <dependency>
            <groupId>com.link</groupId>
            <artifactId>link-im</artifactId>
        </dependency>
        <!--
          引入 MQ 消费层：link-consumer 的 @RabbitListener 监听器随本进程（持有 Netty 长连接）启动，
          消费 restapi 投递的 DirectPushCommand 后调 LinkMessageSender 完成在线推送。
          消费者必须与 sessionMap / Channel 同 JVM——这正是它挂在本接入进程而非 restapi 的原因。
        -->
        <dependency>
            <groupId>com.link</groupId>
            <artifactId>link-consumer</artifactId>
        </dependency>

        <!-- 配置元数据提示（可选） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 只有本模块打成可执行 jar；版本与 lombok 排除由父 POM 的 pluginManagement 提供 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
