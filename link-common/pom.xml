<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.link</groupId>
        <artifactId>cc-link</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>link-common</artifactId>
    <name>link-common</name>
    <description>协议契约 + 响应码 + 纯工具。框架轻量层，谁都能依赖，不反向依赖任何上层模块。</description>

    <!--
      装：PackData / EventType / Protocol、线上 DTO（ack/heart/friend/user）、
          序列化器、channel/user/redis 常量、注解、响应码枚举、纯工具（jwt/md5/id/base91/validator）。
      约束：不引入 netty-all、不引入 spring。
      待办：LinkSerializer.deserialize(ByteBuf) 需改为 deserialize(byte[])，
            否则会被迫依赖 netty-buffer，违背本模块的框架中立目标。
    -->
    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
        </dependency>
        <!-- 日志门面：LinkPrintJsonUtil 等用到 @Slf4j；只引 api，不绑定实现 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

</project>
