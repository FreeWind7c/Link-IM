<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.link</groupId>
        <artifactId>cc-link</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>link-im</artifactId>
    <name>link-im</name>
    <description>入库领域模型：会落 Mongo 的实体、MessageType、多态反序列化器、Mongo 访问基座。与通讯用的 PackData 区分开。</description>

    <!--
      装：im/entity/**、im/entity/message/type/MessageType、im/serialize/AbstractMessageDeserializer、
          im/common/mongo/*、im/common/friend/{LinkFriendSource,LinkFriendStatus}。
      依赖 spring-data-mongodb 是因为实体带 @Id/@Field、基座用 MongoTemplate —— 这正是它不能并入 link-common 的原因。
    -->
    <dependencies>
        <dependency>
            <groupId>com.link</groupId>
            <artifactId>link-common</artifactId>
        </dependency>
        <!--
          依赖 link-core 引擎：业务事件处理（handler/processor/service）实现 core 的 EventHandler
          接口、操作 LinkSession/Channel、用 LinkCoreConfig 与 seq/重发设施。
          依赖方向 link-im → link-core（core 不反向依赖 im），无环。netty / spring / redis 经 core 传递引入。
        -->
        <dependency>
            <groupId>com.link</groupId>
            <artifactId>link-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <!-- AbstractMessageDeserializer 使用 Gson 适配器还原多态 data 子类 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>

</project>
